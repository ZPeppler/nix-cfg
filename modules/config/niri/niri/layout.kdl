layout {
    gaps 9
    center-focused-column "on-overflow"

    always-center-single-column
    preset-column-widths {
        proportion 0.5
        proportion 0.66667
        proportion 1.0 
    }

    default-column-width { proportion 0.5; }
    focus-ring {
        active-color "#7fc8ff"
        inactive-color "#505050"
    }
    border {
        width 2
        active-color "#7fc8ff"
        inactive-color "#505050"
        urgent-color "#9b0000"
    }

    shadow {
        softness 30
        spread 5
        offset x=0 y=5
        color "#0007"
    }

    struts {
    }
  
    background-color "transparent"
}

layer-rule {
  match namespace="^noctalia-wallpaper*"
  place-within-backdrop true
}

overview {
  workspace-shadow {
    off
  }
}
