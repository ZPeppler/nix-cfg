# ======================
# General
# ======================
term xterm-256color
title Kitty-Terminal 
enable_audio_bell yes

# Environment
env LANG=en_US.UTF-8
env LC_CTYPE=en_US.UTF-8

# ======================
# Font
# ======================
font_family JetBrainsMono Nerd Font
font_size 12.5

# Font offsets (equivalent to Alacritty offsets = 0)
modify_font cell_width 0
modify_font cell_height 0

# ======================
# Window
# ======================
confirm_os_window_close 0

# Decorations
hide_window_decorations yes 
#window_padding_width 2
# window_padding_height 2


# Initial window size (Alacritty equivalent)
initial_window_width 1920
initial_window_height 1080

# ======================
# Scrolling
# ======================
scrollback_lines 5000

# ======================
# Cursor
# ======================
cursor_shape beam
cursor_blink_interval 0.5

# ======================
# Keybindings
# ======================

# Copy / Paste
map ctrl+shift+c copy_to_clipboard
map ctrl+shift+v paste_from_clipboard
map shift+insert paste_from_selection

# Font size
map ctrl+0 change_font_size all 0
map ctrl+= change_font_size all +1
map ctrl+- change_font_size all -1

# Clear screen (Ctrl+L)
map ctrl+l clear_terminal reset active

# Scroll
map page_up scroll_page_up
map page_down scroll_page_down
map shift+home scroll_home
map shift+end scroll_end

# ======================
# Colors
# ======================
include tokyonight_storm.conf
